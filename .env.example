# Smart Dashboard Configuration
PORT=3000
MIRROR_PORT=3000
MIRROR_SERVICE_NAME=Smart Dashboard
MIRROR_TOKEN=smart-dashboard-local-token

# Cluster Node Integrations (Raspberry Pi 5 / Home Server)
RPI_HOST=192.168.1.75
IMMICH_PORT=2283
IMMICH_API_KEY=your_immich_api_key_here
DISH_PORT=8080

# Node.js memory tuning for SBCs
NODE_OPTIONS=--max-old-space-size=512
