{
  "name": "smart-dashboard",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "start": "node server/src/start.js",
    "server:check": "node --check server/src/start.js && node --check server/src/index.js && node --check server/src/server.js && node --check server/src/http.js",
    "test": "node --test --experimental-websocket",
    "check": "npm run server:check && npm test"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-logs-otlp-http": "^0.219.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.219.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.220.0",
    "@opentelemetry/host-metrics": "^0.39.0",
    "@opentelemetry/instrumentation-http": "^0.220.0",
    "@opentelemetry/instrumentation-pino": "^0.65.0",
    "@opentelemetry/resources": "^2.8.0",
    "@opentelemetry/sdk-logs": "^0.219.0",
    "@opentelemetry/sdk-metrics": "^2.8.0",
    "@opentelemetry/sdk-node": "^0.219.0",
    "@opentelemetry/sdk-trace-node": "^2.9.0",
    "bonjour-service": "1.3.0",
    "canvas": "^3.2.3",
    "check-disk-space": "^3.4.0",
    "fast-deep-equal": "3.1.3",
    "jsqr": "^1.4.0",
    "node-webcam": "^0.8.2",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "qrcode": "1.5.4"
  },
  "optionalDependencies": {
    "@abandonware/bleno": "^0.6.2"
  },
  "description": "Interactive Smart Dashboard for Linux SBCs (Orange Pi 4 Pro & Raspberry Pi 5): Cluster telemetry, Immich stats, kitchen duty tracker, weather, calendar & gamepad controls",
  "author": "ggrk52 (Sergey Kozlov)"
}