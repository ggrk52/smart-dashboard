[Unit]
Description=Smart Dashboard Max
After=network.target

[Service]
Type=simple
User=orangepi
WorkingDirectory=/home/orangepi/smart-dashboard
Environment=PORT=3000
Environment=MIRROR_PORT=3000
Environment=NODE_OPTIONS=--max-old-space-size=512
ExecStart=/usr/bin/node /home/orangepi/smart-dashboard/server/src/start.js
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
